    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2.5,
        "Ambient": [0.45, 0.45, 0.5],
        "OutdoorAmbient": [0.6, 0.62, 0.7],
        "GlobalShadows": true
      },
      "$path": "src/Lighting"
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
